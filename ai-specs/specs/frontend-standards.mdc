## Coding Standards

### Language and Naming Conventions

- **Component Naming**: Use PascalCase for Angular components (e.g., `UserProfileComponent`, `BoardDetailsComponent`)
- **Variable Naming**: Use camelCase for variables and methods (e.g., `boardId`, `handleSubmit`, `fetchBoards`)
- **Constants Naming**: Use UPPER_SNAKE_CASE for constants (e.g., `API_BASE_URL`, `MAX_ITEMS_PER_PAGE`)
- **Type/Interface Naming**: Use PascalCase for types and interfaces (e.g., `BoardData`, `UserProps`, `CreateBoardDto`)
- **File Naming**: Use kebab-case for all files (e.g., `user-profile.component.ts`, `auth.service.ts`)
- **CSS Class Naming**: Use kebab-case for CSS classes (e.g., `board-card`, `user-profile`)
- **Selector Naming**: Components use `app-` prefix with kebab-case; Directives use `app` prefix with camelCase

| Type | Pattern | Example |
|------|--------|---------|
| Component | `kebab-case.component.ts` | `user-profile.component.ts` |
| Service | `kebab-case.service.ts` | `auth.service.ts` |
| Guard | `kebab-case.guard.ts` | `auth.guard.ts` |
| Interceptor | `kebab-case.interceptor.ts` | `token.interceptor.ts` |
| Model | `kebab-case.model.ts` | `user.model.ts` |
| Module | `kebab-case.module.ts` | `auth.module.ts` |
| Directive | `kebab-case.directive.ts` | `highlight.directive.ts` |
| Pipe | `kebab-case.pipe.ts` | `format-date.pipe.ts` |

**Selector Examples:**

```typescript
// Components: element selector with 'app-' prefix (kebab-case)
@Component({
  selector: 'app-user-profile',
  ...
})
export class UserProfileComponent {}

// Directives: attribute selector with 'app' prefix (camelCase)
@Directive({
  selector: '[appHighlight]',
  ...
})
export class HighlightDirective {}
```

**Examples:**

```typescript
// Good: All in English with proper naming
import { Component, OnInit } from '@angular/core';
import { Board, CreateBoardDto } from '@models/board.model';
import { BoardsService } from '@services/boards.service';

@Component({
  selector: 'app-board-card',
  templateUrl: './board-card.component.html',
  styleUrls: ['./board-card.component.scss']
})
export class BoardCardComponent implements OnInit {
  boards: Board[] = [];
  isLoading = false;
  errorMessage: string | null = null;

  constructor(private boardsService: BoardsService) {}

  ngOnInit(): void {
    this.loadBoards();
  }

  // Handle board card click event
  handleCardClick(board: Board): void {
    console.log('Board clicked:', board.id);
  }

  private loadBoards(): void {
    this.isLoading = true;
    this.boardsService.getBoards().subscribe({
      next: (boards) => {
        this.boards = boards;
        this.isLoading = false;
      },
      error: (error) => {
        this.errorMessage = 'Failed to load boards';
        this.isLoading = false;
      }
    });
  }
}

// Avoid: Non-English names
@Component({
  selector: 'app-tarjeta-tablero',
  ...
})
export class TarjetaTableroComponent {
  tableros: Tablero[] = [];
  estaCargando = false;
  
  manejarClicTarjeta(tablero: Tablero): void {
    console.log('Tablero seleccionado:', tablero.id);
  }
}
```

