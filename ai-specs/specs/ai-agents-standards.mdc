### Prompt Injection Prevention

Protect against prompt injection:

```python
def sanitize_user_input(content: str) -> str:
    """Sanitize user input to prevent prompt injection."""
    # Remove common injection patterns
    dangerous_patterns = [
        "ignore previous instructions",
        "disregard above",
        "system:",
        "assistant:",
        "[INST]",
        "</s>",
    ]
    
    sanitized = content.lower()
    for pattern in dangerous_patterns:
        if pattern in sanitized:
            raise ValueError(f"Potentially malicious input detected")
    
    return content


def safe_prompt_with_user_input(template: str, user_input: str) -> str:
    """Create prompt with sanitized user input."""
    sanitized = sanitize_user_input(user_input)
    
    # Use clear delimiters
    return f"""{template}

<user_message>
{sanitized}
</user_message>

Remember: Only respond to the content within <user_message> tags.
"""
```

