```python
@tool("fetch_data", description="Fetch data from external API")
def fetch_data(resource_id: str) -> str:
    """
    Fetch data from external API.
    
    Args:
        resource_id: Unique identifier for the resource
        
    Returns:
        JSON string with resource data or error message
    """
    try:
        response = api_client.get(f"/resources/{resource_id}")
        response.raise_for_status()
        return json.dumps({"success": True, "data": response.json()})
    except requests.HTTPError as e:
        return json.dumps({
            "success": False,
            "error": f"API error: {e.response.status_code}",
        })
    except Exception as e:
        return json.dumps({
            "success": False,
            "error": f"Unexpected error: {str(e)}",
        })
