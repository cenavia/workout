# Truncate long messages
def truncate_message(content: str, max_tokens: int = 1000) -> str:
    """Truncate message to approximate token limit."""
    # Rough estimate: 1 token ≈ 4 characters
    max_chars = max_tokens * 4
    if len(content) > max_chars:
        return content[:max_chars] + "..."
    return content


# Summarize conversation history
def summarize_if_needed(messages: list, threshold: int = 20) -> list:
    """Summarize old messages if conversation is long."""
    if len(messages) <= threshold:
        return messages
    
    old_messages = messages[:-10]
    recent_messages = messages[-10:]
    
    summary = llm.invoke(f"Summarize this conversation: {old_messages}")
    
    return [SystemMessage(content=f"Previous conversation summary: {summary.content}")] + recent_messages
```

