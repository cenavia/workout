from pydantic import BaseModel, Field, validator
from typing import Literal


class ChatRequest(BaseModel):
    """Validated chat request."""
    message: str = Field(..., min_length=1, max_length=10000)
    thread_id: str = Field(..., pattern=r"^[a-zA-Z0-9-]+$")
    
    @validator("message")
    def sanitize_message(cls, v):
        """Remove potentially harmful content."""
        # Remove control characters
        v = "".join(char for char in v if ord(char) >= 32 or char in "\n\t")
        return v.strip()


class ToolParameters(BaseModel):
    """Validated tool parameters."""
    action: Literal["search", "create", "update", "delete"]
    resource_id: str = Field(..., pattern=r"^[a-zA-Z0-9-]+$")
    data: dict = Field(default_factory=dict)
