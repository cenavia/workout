### Error Handling for LLMs

Handle LLM errors gracefully:

```python
from langchain_core.exceptions import OutputParserException
from tenacity import retry, stop_after_attempt, wait_exponential


class LLMError(Exception):
    """Custom exception for LLM errors."""
    pass


@retry(
    stop=stop_after_attempt(3),
    wait=wait_exponential(multiplier=1, min=1, max=10)
)
def invoke_with_retry(llm, messages):
    """Invoke LLM with retry logic."""
    try:
        return llm.invoke(messages)
    except OutputParserException as e:
        raise LLMError(f"Failed to parse LLM output: {e}")
    except Exception as e:
        raise LLMError(f"LLM invocation failed: {e}")


def safe_extraction(state: State) -> dict:
    """Extract with fallback on error."""
    try:
        result = structured_llm.invoke(state["messages"])
        return {"extracted_data": result.model_dump()}
    except LLMError as e:
        logger.warning(f"Extraction failed, using defaults: {e}")
        return {"extracted_data": {}, "extraction_error": str(e)}
```

