                    "user_id": user_id,
                    "session_id": session_id,
                    "timestamp": datetime.utcnow().isoformat(),
                }
            }
        )
```

## Development Workflow

### Git Workflow

- **Feature Branches**: Use descriptive branch names with `-agent` suffix
- **Commit Messages**: Write clear, descriptive commits in English
- **Code Review**: All changes require review before merging

```bash
# Branch naming
feature/add-rag-agent
fix/extraction-node-error
refactor/improve-routing-logic

# Commit message format
<type>(<scope>): <description>

# Examples
feat(agent): add RAG retrieval node
fix(tools): handle API timeout errors
docs(readme): update setup instructions
test(extractor): add unit tests for edge cases
```

### Development Scripts

```bash
# justfile commands
just install        # Install dependencies
just install-dev    # Install with dev dependencies
just run            # Run LangGraph dev server
just test           # Run tests
just lint           # Lint code
just format         # Format code
just db-up          # Start PostgreSQL
just db-down        # Stop PostgreSQL
```

### Code Quality

Run these before committing:

```bash
# Format code
uv run ruff format src/

# Lint and fix
uv run ruff check src/ --fix

# Run tests
uv run pytest

# Type checking (optional)
uv run mypy src/
```

## Deployment

### LangGraph Platform

Configure `langgraph.json` for deployment:

```json
{
  "$schema": "https://langchain-ai.github.io/langgraph/schemas/langgraph.json",
  "dependencies": ["."],
  "graphs": {
    "agent": "./src/agents/main.py:agent",
    "rag_agent": "./src/agents/rag/agent.py:agent"
  },
  "env": ".env"
}
```

### Docker Configuration

```yaml
# docker-compose.yml
services:
  postgres:
    image: postgres:16-alpine
    container_name: ${PROJECT_NAME}-db
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: ${PROJECT_NAME}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5

volumes:
  postgres_data:
```

### Environment Configuration

```bash
# Production .env
OPENAI_API_KEY=sk-prod-xxx
DATABASE_URL=postgresql://user:pass@prod-host:5432/dbname

# LangSmith (production)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-prod-xxx
LANGCHAIN_PROJECT=my-agent-production

# Security
ALLOWED_ORIGINS=https://myapp.com
API_KEY_HASH=xxx
```

