### Either Pattern for Error Handling

The Either pattern provides explicit error handling without exceptions.

**Either Implementation:**
```typescript
// src/contexts/shared/domain/either.ts
export type Either<L, R> = Left<L, R> | Right<L, R>;

export class Left<L, R> {
  readonly value: L;

  constructor(value: L) {
    this.value = value;
  }

  isLeft(): this is Left<L, R> {
    return true;
  }

  isRight(): this is Right<L, R> {
    return false;
  }

  fold<U>(onLeft: (value: L) => U, _onRight: (value: R) => U): U {
    return onLeft(this.value);
  }
}

export class Right<L, R> {
  readonly value: R;

  constructor(value: R) {
    this.value = value;
  }

  isLeft(): this is Left<L, R> {
    return false;
  }

  isRight(): this is Right<L, R> {
    return true;
  }

  fold<U>(_onLeft: (value: L) => U, onRight: (value: R) => U): U {
    return onRight(this.value);
  }
}

export const left = <L, R>(value: L): Either<L, R> => new Left(value);
export const right = <L, R>(value: R): Either<L, R> => new Right(value);
```

**Usage in Use Case:**
```typescript
type CancelBookingError = BookingNotFoundError | BookingAlreadyCancelledError;

export class CancelBookingUseCase
  implements UseCaseWithResult<CancelBookingDto, CancelBookingError, BookingResponseDto>
{
  async execute(input: CancelBookingDto): Promise<Either<CancelBookingError, BookingResponseDto>> {
    const booking = await this.bookingRepository.findById(bookingId);
    if (!booking) {
      return left(new BookingNotFoundError(input.bookingId));
    }

    try {
      booking.cancel();
    } catch (error) {
      if (error instanceof BookingAlreadyCancelledError) {
        return left(error);
      }
      throw error;
    }

    await this.bookingRepository.save(booking);
    return right(BookingMapper.toResponse(booking));
  }
}
```

**Usage in Controller:**
```typescript
const result = await cancelBookingUseCase.execute({ bookingId });

result.fold(
  (error) => {
    if (error instanceof BookingNotFoundError) {
      return res.status(404).json(error.toJSON());
    }
    return res.status(400).json(error.toJSON());
  },
  (booking) => {
    return res.status(200).json(booking);
  }
);
```

